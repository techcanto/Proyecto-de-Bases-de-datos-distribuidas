# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copia este archivo a .env y rellena los valores reales.
# El archivo .env NUNCA se sube a git (está en .gitignore).
#
# Uso:
#   cp .env.example .env
#   nano .env   (o el editor que prefieras)
# ─────────────────────────────────────────────────────────────────────────────

# ── Nodo 0 ────────────────────────────────────────────────────────────────────
NODE0_HOST=100.x.x.x
NODE0_PORT=3306
NODE0_DB=nombre_de_la_bd_0
NODE0_USER=nombre_usuario_mariadb
# IMPORTANTE: La contraseña debe ser solo ASCII (sin ñ ni acentos).
# Si tu usuario de MariaDB tiene contraseña con ñ, cámbiala así:
#   mariadb -u 'TuUsuario' -p'ContraseñaActual' -e "SET PASSWORD = PASSWORD('NuevaContrasenaSinEnie123!');"
NODE0_PASSWORD=contraseña_ascii_sin_eñe

# ── Nodo 1 ────────────────────────────────────────────────────────────────────
NODE1_HOST=100.x.x.x
NODE1_PORT=3306
NODE1_DB=nombre_de_la_bd_1
NODE1_USER=nombre_usuario_mariadb
NODE1_PASSWORD=contraseña_ascii_sin_eñe

# ── Configuración general ─────────────────────────────────────────────────────
# Tamaño de bloque de IDs por nodo (no cambiar si ya hay datos insertados)
BLOCK_SIZE=1500
